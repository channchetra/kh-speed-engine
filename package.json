{
  "name": "kh-speed-engine",
  "version": "4.2.2",
  "private": true,
  "type": "module",
  "description": "Build tooling and optional local optimizers for the KH Speed Engine WordPress plugin.",
  "scripts": {
    "dev": "bunx vite --host 127.0.0.1",
    "build": "bunx vite build",
    "build:release": "bun run build && powershell -ExecutionPolicy Bypass -File ./bin/build-release.ps1",
    "build:release:sh": "bash ./bin/build-release.sh",
    "release": "powershell -ExecutionPolicy Bypass -File ./bin/release.ps1",
    "release:patch": "powershell -ExecutionPolicy Bypass -File ./bin/release.ps1 -Bump patch",
    "release:minor": "powershell -ExecutionPolicy Bypass -File ./bin/release.ps1 -Bump minor",
    "release:major": "powershell -ExecutionPolicy Bypass -File ./bin/release.ps1 -Bump major",
    "release:sh": "bash ./bin/release.sh",
    "release:sh:patch": "bash ./bin/release.sh --bump patch",
    "release:sh:minor": "bash ./bin/release.sh --bump minor",
    "release:sh:major": "bash ./bin/release.sh --bump major",
    "test:js": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:frontend": "playwright test tests/e2e/frontend.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "8.0.14",
    "vitest": "^5.1.0"
  }
}
